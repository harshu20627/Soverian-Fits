# Create an EmailJS service and templates, copy this file to .env and fill in the IDs.
# Set the notification template recipient to the store inbox (currently harshmarothiya3535@gmail.com).
# Set the confirmation template recipient to {{to_email}} and Reply-To to {{reply_to}}.
# Templates can use: {{event_type}}, {{from_name}}, {{from_email}}, {{to_email}}, {{reply_to}},
# {{phone}}, {{order_id}}, {{order_date}}, {{order_status}}, {{payment_method}}, {{payment_status}},
# {{order_total}}, {{delivery_address}}, {{order_items}}, {{subject}}, {{message}}, {{details}}.
# Never include passwords, payment credentials, or one-time passcodes in email templates.
VITE_EMAILJS_SERVICE_ID=
# Contact, support, and product-review notification template; its To Email must be the fixed store inbox.
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Customer receipt/welcome template; its To Email should be {{to_email}}.
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=
# Newsletter notification template; its To Email must be the fixed store inbox.
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=
# COD order notification template; its To Email must be the fixed store inbox.
VITE_EMAILJS_ORDER_TEMPLATE_ID=
# Optional server endpoint. It should securely save the subscriber and send both store and customer emails.
VITE_NEWSLETTER_ENDPOINT=
# Optional server endpoint. It should send store and customer order emails only after it accepts the COD order.
VITE_ORDER_NOTIFICATION_ENDPOINT=
# Optional: server endpoints. The tracking endpoint accepts POST { orderId, emailOrPhone }
# and returns { order: { id, status, ... } } (or the order object directly).
VITE_ORDER_TRACKING_ENDPOINT=
# When set, this endpoint accepts POST { name, email, orderId, subject, message }, saves the request,
# and sends both the store notification and customer confirmation. Otherwise, EmailJS sends the emails.
VITE_SUPPORT_API_ENDPOINT=
# Optional: backend endpoint that creates a provider checkout session and returns { "checkoutUrl": "..." }.
# The backend must recalculate prices, verify provider signatures, and confirm payment before creating a paid order.
VITE_PAYMENT_CHECKOUT_ENDPOINT=
